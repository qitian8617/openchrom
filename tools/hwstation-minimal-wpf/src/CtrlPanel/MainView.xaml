<UserControl x:Class="HwMinimal.CtrlPanel.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HwMinimal.CtrlPanel"
             Background="#FFFFFF" Foreground="#1A1A1A">
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CaretBrush" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <ControlTemplate x:Key="FlatButton" TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#1A243A"/>
          <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Bd" Property="Background" Value="#ECEFF4"/>
          <Setter Property="Foreground" Value="#5C6570"/>
          <Setter TargetName="Bd" Property="BorderBrush" Value="#DAE1EA"/>
          <Setter TargetName="Bd" Property="Opacity" Value="1"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#16243A"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DAE1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="90"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="0,7,0,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#D6E2F6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6FEB"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingTabButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#4E5C6B"/>
      <Setter Property="Background" Value="#ECEFF2"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="4,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6FEB"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Width="600" LastChildFill="True" Background="#FFFFFF">
      <StackPanel DockPanel.Dock="Top" Background="#F7FAFD">
        <DockPanel Height="36" Background="#F8FAFD">
          <Border Width="28" Height="22" Margin="12,0,8,0" Background="#E0EDFF" CornerRadius="4" VerticalAlignment="Center">
            <TextBlock Text="GC" FontSize="12" FontWeight="Bold" Foreground="#2F6FEB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="气相色谱仪控制平台" FontSize="16" FontWeight="Bold" Foreground="#16243A" VerticalAlignment="Center"/>
        </DockPanel>
        <UniformGrid Columns="6" Height="90" Background="#EEF2F7">
          <Button Tag="0" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon0" Type="0" Width="42" Height="42" Active="True"/><TextBlock x:Name="NavLabel0" Text="主界面" FontSize="13" Foreground="#2F6FEB" FontWeight="Bold" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
          <Button Tag="1" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon1" Type="1" Width="42" Height="42"/><TextBlock x:Name="NavLabel1" Text="柱箱" FontSize="13" Foreground="#7E8C9E" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
          <Button Tag="2" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon2" Type="2" Width="42" Height="42"/><TextBlock x:Name="NavLabel2" Text="检测器" FontSize="13" Foreground="#7E8C9E" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
          <Button Tag="3" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon3" Type="3" Width="42" Height="42"/><TextBlock x:Name="NavLabel3" Text="事件" FontSize="13" Foreground="#7E8C9E" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
          <Button Tag="4" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon4" Type="4" Width="42" Height="42"/><TextBlock x:Name="NavLabel4" Text="秒表" FontSize="13" Foreground="#7E8C9E" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
          <Button Tag="5" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel><local:NavIcon x:Name="NavIcon5" Type="5" Width="42" Height="42"/><TextBlock x:Name="NavLabel5" Text="设置" FontSize="13" Foreground="#7E8C9E" HorizontalAlignment="Center" Height="28" TextAlignment="Center"/></StackPanel></Button>
        </UniformGrid>
      </StackPanel>
      <Grid>
        <Grid x:Name="PageMain">
          <DockPanel Background="#F4F5F7" LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="True">
              <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,1" BorderBrush="#8A1C1C" BorderThickness="1" Background="#F8ECEC" VerticalAlignment="Center">
                <TextBlock FontSize="12" Foreground="#8A1C1C" Text="未验证新鲜度"/>
              </Border>
              <TextBlock x:Name="StatusText" FontSize="13" VerticalAlignment="Center" Text="未连接  192.168.1.30:8234"/>
            </DockPanel>
            <Border DockPanel.Dock="Bottom" Background="#F1F5FA" BorderBrush="#DAE1EA" BorderThickness="0,1,0,0" Padding="8,4,8,6">
              <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="设置" Width="62" Height="32" FontSize="13" Margin="0,0,8,0" Click="OpenSettings_Click"/>
                  <Button Content="读取" Width="62" Height="32" FontSize="13" Click="ReadTemps_Click"/>
                </StackPanel>
                <TextBlock x:Name="AcqStatusText" Margin="2,6,2,0" FontSize="13" Foreground="#7E8C9E" TextTrimming="CharacterEllipsis" Text="采集状态: 待机"/>
                <Border Margin="4,8,4,0" Padding="12,8" Background="#FFFFFF" BorderBrush="#DAE1EA" BorderThickness="1">
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="ValveButton" Height="48" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Background="#7E8C9E" BorderThickness="0" Click="ValveToggle_Click" Content="空气阀状态未知"/>
                      <Button x:Name="IgniteButton" Grid.Column="2" Height="48" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Background="#A32020" BorderThickness="0" Click="IgniteMain_Click" Content="执行点火流程"/>
                    </Grid>
                    <DockPanel Height="40" LastChildFill="True">
                      <Button x:Name="HeatButton" DockPanel.Dock="Right" Width="150" Height="36" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Background="#2F6FEB" BorderThickness="0" Click="HeatToggle_Click" Content="启动"/>
                      <TextBlock Text="温度控制" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="HeatText" FontSize="12" Foreground="#7E8C9E" TextTrimming="CharacterEllipsis" Text="温控状态未知。停止仍可发送。"/>
                    <TextBlock x:Name="ZoneText" FontSize="12" Foreground="#7E8C9E" TextTrimming="CharacterEllipsis" Text="气压未读取。"/>
                    <DockPanel Height="40" Margin="0,4,0,0" LastChildFill="True">
                      <Button x:Name="AnalysisButton" DockPanel.Dock="Right" Width="150" Height="36" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Background="#2F6FEB" BorderThickness="0" Click="AnalysisToggle_Click" Content="启动"/>
                      <TextBlock Text="开始分析" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#F4F5F7" VerticalAlignment="Stretch">
              <Grid Width="600" Margin="0,8,0,0" VerticalAlignment="Top" Background="#F4F5F7">
              <Canvas x:Name="SchematicCanvas" Width="556" Height="430" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#F4F5F7">
                <Image x:Name="FidImage" Source="Assets/gc_fid.png" Stretch="Uniform"/>
                <Image x:Name="FilamentImage" Source="Assets/gc_fid_filament_hot.png" Stretch="Uniform" Visibility="Collapsed"/>
                <Image x:Name="FlameImage" Source="Assets/gc_blue_flame.png" Stretch="Uniform" Visibility="Collapsed"/>
                <Image x:Name="InletImage" Source="Assets/gc_inlet.png" Stretch="Uniform"/>
                <Image x:Name="ColumnImage" Source="Assets/gc_column.png" Stretch="Uniform"/>
                <TextBlock x:Name="ColumnCaption" FontSize="13" Foreground="#191C20" Text="色谱柱"/>
                <Path x:Name="LeftPipe" Stroke="#8A6236" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="RightPipe" Stroke="#8A6236" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="GasDotA" Width="6" Height="6" Fill="#2F6FED" Visibility="Collapsed"/>
                <Ellipse x:Name="GasDotB" Width="6" Height="6" Fill="#2F6FED" Visibility="Collapsed"/>
                <Border x:Name="DetBorder" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4">
                  <TextBlock x:Name="DetCard" FontSize="12" Foreground="#5C6570" TextWrapping="Wrap" Text="检测器&#10;设定 未读取到&#10;实测 未读取到"/>
                </Border>
                <Border x:Name="InletBorder" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4">
                  <TextBlock x:Name="InletCard" FontSize="12" Foreground="#5C6570" TextWrapping="Wrap" Text="进样口&#10;设定 未读取到&#10;实测 未读取到"/>
                </Border>
                <Border x:Name="OvenBorder" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4">
                  <TextBlock x:Name="OvenCard" FontSize="12" Foreground="#5C6570" TextWrapping="Wrap" Text="柱箱&#10;设定 未读取到&#10;实测 未读取到"/>
                </Border>
                <Border x:Name="VentBorder" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4">
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#5A7A90" HorizontalAlignment="Center" Text="散热口"/>
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,2,0,0">
                      <Image Source="Assets/gc_oven_vent_frame.png" Stretch="Uniform"/>
                      <Image x:Name="VentDoor" Source="Assets/gc_oven_vent_door.png" Stretch="Uniform" RenderTransformOrigin="0.5,0">
                        <Image.RenderTransform>
                          <RotateTransform x:Name="VentDoorRotate" Angle="0"/>
                        </Image.RenderTransform>
                      </Image>
                    </Grid>
                    <TextBlock x:Name="VentCard" FontSize="11" Foreground="#7E8C9E" HorizontalAlignment="Center" Text="未知"/>
                  </StackPanel>
                </Border>
                <Border x:Name="FanBorder" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4">
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#5A7A90" HorizontalAlignment="Center" Text="柱箱风扇"/>
                    <Image x:Name="FanImage" Source="Assets/gc_oven_fan.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,4,0,0" RenderTransformOrigin="0.5,0.5">
                      <Image.RenderTransform>
                        <RotateTransform x:Name="FanRotate" Angle="0"/>
                      </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="FanCard" FontSize="11" Foreground="#7E8C9E" HorizontalAlignment="Center" Text="未知"/>
                  </StackPanel>
                </Border>
              </Canvas>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Grid>
        <Grid x:Name="PageOven" Visibility="Collapsed">
          <StackPanel Margin="8">
            <TextBlock TextWrapping="Wrap" Text="只发送操作者填入的温程。空表不发送，也不填一套默认程序。"/>
            <TextBlock Margin="0,6,0,0" Text="最高温度 / 平衡 / 稳定秒 / 循环0或1"/>
            <TextBox x:Name="OvenHead" Margin="0,2,0,0"/>
            <TextBlock Margin="0,6,0,0" Text="阶梯：每行 速率 温度 保持，最多 8 行"/>
            <TextBox x:Name="OvenRows" AcceptsReturn="True" Height="90" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="读取温程" Width="100" Margin="0,0,8,0" Click="ReadProgram_Click"/>
              <Button Content="写入温程" Width="100" Click="WriteProgram_Click"/>
            </StackPanel>
            <TextBlock x:Name="OvenText" Margin="0,6,0,0" TextWrapping="Wrap" Text="温程未读取"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageDetector" Visibility="Collapsed">
          <StackPanel Margin="8">
            <TextBlock x:Name="DetText" TextWrapping="Wrap" Text="氢气、空气、火焰、电流：未读取。点火应答不代表火焰已着。"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="读取气压和FID" Width="130" Margin="0,0,8,0" Click="ReadDetector_Click"/>
              <Button Content="点火" Width="70" Margin="0,0,8,0" Click="Ignite_Click"/>
              <Button Content="开空气阀" Width="90" Margin="0,0,8,0" Click="ValveOn_Click"/>
              <Button Content="关空气阀" Width="90" Margin="0,0,8,0" Click="ValveOff_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="自动点火开" Width="110" Margin="0,0,8,0" Click="AutoOn_Click"/>
              <Button Content="自动点火关" Width="110" Click="AutoOff_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageEvents" Visibility="Collapsed">
          <StackPanel Margin="8">
            <TextBlock TextWrapping="Wrap" Text="这里只保存已经读到的故障记录，不向仪器发送定时或触发命令，也不放入示例事件。"/>
            <ListBox x:Name="Events" Height="180" Margin="0,6,0,0"/>
            <Button Content="清除本机记录" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ClearEvents_Click"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageWatch" Visibility="Collapsed">
          <StackPanel Margin="8">
            <TextBlock Text="本机计时，不向仪器发送命令。"/>
            <TextBlock x:Name="WatchText" Margin="0,8,0,0" FontSize="20" Text="00:00"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="开始" Width="70" Margin="0,0,8,0" Click="WatchStart_Click"/>
              <Button Content="停止" Width="70" Margin="0,0,8,0" Click="WatchStop_Click"/>
              <Button Content="归零" Width="70" Click="WatchReset_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageSettings" Visibility="Collapsed" Background="#F1F5FA">
          <DockPanel>
            <UniformGrid DockPanel.Dock="Top" Columns="4" Height="44" Background="#FFFFFF">
              <Button x:Name="SettingTab0" Tag="0" Style="{StaticResource SettingTabButton}" Content="温度校准" Click="SettingTab_Click" Foreground="#FFFFFF" Background="#2A3542"/>
              <Button x:Name="SettingTab1" Tag="1" Style="{StaticResource SettingTabButton}" Content="PID设置" Click="SettingTab_Click"/>
              <Button x:Name="SettingTab2" Tag="2" Style="{StaticResource SettingTabButton}" Content="参数设置" Click="SettingTab_Click"/>
              <Button x:Name="SettingTab3" Tag="3" Style="{StaticResource SettingTabButton}" Content="通讯" Click="SettingTab_Click"/>
            </UniformGrid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="8">
                <StackPanel x:Name="SettingsCalib">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#16243A" Text="温度校准"/>
                  <TextBlock Margin="0,8,0,0" Text="温度校准设定（℃），空着不发送"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBox x:Name="InletSet" Width="80" Margin="0,0,8,0"/>
                    <TextBox x:Name="DetSet" Width="80" Margin="0,0,8,0"/>
                    <Button Content="写入进样口/检测器设定" Click="WriteCalibration_Click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SettingsPid" Visibility="Collapsed">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#16243A" Text="PID设置"/>
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="PID 写入需要本进程口令。不读取 OpenChrom 口令，没有默认口令。"/>
                  <PasswordBox x:Name="EngineerPassword" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="建立口令" Width="90" Margin="0,0,8,0" Click="Enroll_Click"/>
                    <Button Content="解锁" Width="70" Margin="0,0,8,0" Click="Unlock_Click"/>
                    <Button Content="锁定" Width="70" Click="Lock_Click"/>
                  </StackPanel>
                  <TextBlock Margin="0,8,0,0" Text="柱箱 / 进样口 / 检测器 PID，每行三个数 kp ki kd"/>
                  <TextBox x:Name="PidBox" Width="220" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <TextBox x:Name="InletPidBox" Width="220" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <TextBox x:Name="DetPidBox" Width="220" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="读取三路PID" Width="110" Margin="0,0,8,0" Click="ReadPid_Click"/>
                    <Button Content="写入三路PID" Width="110" Click="WritePid_Click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="SettingsParams" Visibility="Collapsed">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#16243A" Text="参数设置"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="Bold" Foreground="#8A1C1C" Text="无法验证设备样本新鲜度，仅接入验证，不用于正式定量"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="启动不会自动连接，也不会发写命令。确认一次之后，开始分析不再每次询问。这不是正式定量，也不是完整验收。"/>
                  <TextBlock x:Name="ProcessText" TextWrapping="Wrap" Margin="0,8,0,0" Text="窗口类和进程说明在这里，不占主界面。"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="固件帧没有新鲜度位。未点火、未进样时读数保持未知。停止分析不是停热。断开或关窗口后加热仍可能继续。"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="工作站频率文件只读解析。程序不会改 D:\HWGMP，也不会为了凑 20 Hz 复制样本。"/>
                  <TextBlock x:Name="ConfigText" Margin="0,4,0,0" TextWrapping="Wrap" Text="尚未选择 HWFrequence.txt。"/>
                  <Button Content="选择 HWFrequence.txt" Width="180" HorizontalAlignment="Left" Margin="0,6,0,0" Click="PickConfig_Click"/>
                  <CheckBox x:Name="AcceptBox" Margin="0,8,0,0" Content="记录一次：已知晓单位和新鲜度限制，以后开始分析不再询问。仍不能用于正式定量。"/>
                </StackPanel>
                <StackPanel x:Name="SettingsComm" Visibility="Collapsed">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#16243A" Text="通讯"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="连接、DLL、频率和日志在这里。日常开始分析不在这些诊断按钮上拼接。"/>
                  <TextBlock Margin="0,8,0,0" Text="主机（默认 192.168.1.30，启动不连接）"/>
                  <TextBox x:Name="HostBox" Width="220" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <TextBlock Margin="0,6,0,0" Text="端口（默认 8234，启动不连接）"/>
                  <TextBox x:Name="PortBox" Width="80" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="保存地址" Width="88" Margin="0,0,8,4" Click="SaveSettings_Click"/>
                    <Button Content="连接" Width="88" Margin="0,0,8,4" Click="Connect_Click"/>
                    <Button Content="断开" Width="88" Margin="0,0,8,4" Click="Disconnect_Click"/>
                    <Button Content="开始设备采集" Width="120" Margin="0,0,8,4" Click="StartAcq_Click"/>
                    <Button Content="停止设备采集" Width="120" Margin="0,0,0,4" Click="StopAcq_Click"/>
                  </WrapPanel>
                  <TextBlock Margin="0,12,0,0" Text="最近样本（只显示，不代表已经转发）"/>
                  <ListBox x:Name="Samples" Height="120" Margin="0,2,0,0"/>
                  <TextBlock Margin="0,12,0,0" Text="厂商 DLL 完整路径（启动时为空，允许转发时才加载）"/>
                  <DockPanel Margin="0,2,0,0">
                    <Button Content="浏览" Width="64" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PickDll_Click"/>
                    <TextBox x:Name="DllBox"/>
                  </DockPanel>
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="允许转发" Width="100" Margin="0,0,8,4" Click="Arm_Click"/>
                    <Button Content="停止转发" Width="100" Margin="0,0,8,4" Click="Disarm_Click"/>
                    <Button Content="工作站 A 开始 (1,0,1)" Width="170" Margin="0,0,8,4" Click="HwStart_Click"/>
                    <Button Content="工作站 A 停止 (1,0,2)" Width="170" Margin="0,0,8,4" Click="HwStop_Click"/>
                    <Button Content="仅 A 归零 (1,0,5)" Width="140" Margin="0,0,0,4" Click="HwZero_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="DllText" Margin="0,8,0,0" TextWrapping="Wrap" Text="尚未加载 DLL。返回 1 只表示找到 HWClass 并发出消息，不是采集成功，也不是 HW 已在记录。返回 0 表示没有找到该窗口。"/>
                  <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="通信页不发送 READ_NET_CONFIG 或写网络。那些命令没有列入可发送集合。"/>
                  <Button Content="读取控制状态" HorizontalAlignment="Left" Margin="0,4,0,0" Click="ReadStatus_Click"/>
                  <TextBlock x:Name="LinkText" Margin="0,4,0,0" TextWrapping="Wrap" Text="控制状态未读取"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Grid>
    </DockPanel>
</UserControl>

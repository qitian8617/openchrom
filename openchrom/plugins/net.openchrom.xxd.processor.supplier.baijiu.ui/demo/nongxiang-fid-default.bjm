# 浓香 FID 默认厂方法包 / Nongxiang FID default plant-method package
# Frozen (item 9): XP-白酒 C2 + 乙酸正丁酯 + 15-mix, UTF-8 Properties (*.bjm).
# Column: XP-白酒 C2, 30 m × 0.32 mm ID × 1.00 µm, MAX 250 °C, S/N 24090305
# ISTD: 乙酸正丁酯  17.6 g/L; 加标 1.00 mL + 0.10 mL
# Instrument RT = vendor RT + 0.055 min (demo chromatograms mix-15plus-istd.ocb / sample-nongxiang.ocb)
# GB 2757 methanol limits live in this package / preferences, not hardcoded in judge logic.
# No RF in the frozen template — run 用当前谱图做校正 before 定量.
# Keep in sync with classpath baijiu-defaults.properties and nongxiang-fid-default.bjm.
method.name=浓香 FID 默认方法
column.summary=XP-白酒 C2, 30 m × 0.32 mm ID × 1.00 µm, MAX 250 °C, S/N 24090305
oven.program=60 ℃ 保持 2 min，8 ℃/min 升至 180 ℃（约 19 min，与演示谱图一致）
sampling.hz=20
runtime.min=19
istd.name=乙酸正丁酯
istd.stock.gl=17.6
volume.sample.ml=1.00
volume.istd.ml=0.10
rt.window.min=0.15
instrument.rt.offset.min=0.055
